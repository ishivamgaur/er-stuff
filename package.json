{
  "name": "developer-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:categories": "tsx --env-file=.env.local scripts/seed-categories.ts",
    "db:seed:tools": "tsx --env-file=.env.local scripts/seed-tools.ts",
    "db:capture-previews": "tsx --env-file=.env.local scripts/capture-previews.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "check:mobile": "tsx scripts/check-mobile-nav.ts",
    "check:nav": "tsx scripts/check-nav.ts",
    "check:scroll": "tsx scripts/check-scroll.ts",
    "check:redesign": "tsx scripts/check-redesign.ts",
    "audit:orphans": "tsx scripts/audit-orphans.ts",
    "db:sponsored": "tsx --env-file=.env.local scripts/set-sponsored.ts",
    "check:auth": "tsx scripts/check-auth.ts",
    "db:promote": "tsx --env-file=.env.local scripts/promote-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lenis": "^1.3.26",
    "mongoose": "^8.24.4",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reicon-react": "^1.2.6",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
