MONGODB_URI=mongodb://127.0.0.1:27017/erstuff
MONGODB_DB=erstuff
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SEARCH_PROVIDER=fallback
ATLAS_SEARCH_INDEX=default_search
NEXT_PUBLIC_SITE_URL=https://erstuff.dev

# Better Auth. Leave BETTER_AUTH_SECRET blank in dev, it generates one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign in. The button stays hidden until both are set.
# Create an OAuth client at console.cloud.google.com, add
# http://localhost:3000/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
